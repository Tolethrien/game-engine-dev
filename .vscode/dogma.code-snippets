{
  // Place your core workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "insert entity": {
    "scope": "javascript,typescript",
    "prefix": "dogma",
    "body": [
      "import DogmaEntity from '@/core/dogma/entity';interface ${1:name}Props {}export default class ${1:name} extends DogmaEntity {constructor({}:${1:name}Props) {super();$0}}",
    ],
    "description": "Add Entity boilerplate",
  },
  "insert component": {
    "scope": "javascript,typescript",
    "prefix": "dogma",
    "body": [
      "import DogmaComponent from '@/core/dogma/component';interface ${1:name}Props {}export default class ${1:name} extends DogmaComponent {constructor(componentProps: DogmaComponentProps,{}: ${1:name}Props) {super(componentProps);}}",
    ],
    "description": "Add Dogma Entity boilerplate",
  },
  "insert system": {
    "scope": "javascript,typescript",
    "prefix": "dogma",
    "body": [
      "import DogmaSystem from '@/core/dogma/system';export default class ${1:name} extends DogmaSystem {constructor() {super();$0}}",
    ],
    "description": "Add Dogma System boilerplate",
  },
}
