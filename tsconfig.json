{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@sandbox/*": ["./src/sandbox/*"],
      "@engine/*": ["./src/core/engine/*"],
      "@dogma/*": ["./src/core/dogma/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["@webgpu/types"]
  }
}
