{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@sandbox/*": ["./src/sandbox/*"],
      "@engine/*": ["./src/core/engine/*"],
      "@dogma/*": ["./src/core/dogma/*"],
      "@pragma/*": ["./src/core/pragma/*"],
      "@aurora/*": ["./src/core/aurora/*"],
      "@cello/*": ["./src/core/cello/*"],
      "@navi/*": ["./src/core/navi/*"],
      "@axiom/*": ["./src/core/axiom/*"],
      "@debug": ["./src/core/debugger/debug.ts"]
    },
    "resolveJsonModule": true,
    "types": ["@webgpu/types"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}
