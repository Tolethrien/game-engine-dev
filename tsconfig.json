{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@sandbox/*": ["./src/sandbox/*"],
      "@engine/*": ["./src/core/engine/*"],
      "@dogma/*": ["./src/core/dogma/*"],
      "@debug": ["./src/core/debugger/debug.ts"],
      "@utils/*": ["./src/utils/*"]
    },
    "resolveJsonModule": true,
    "types": ["@webgpu/types"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}
